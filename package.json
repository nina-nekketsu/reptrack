{
  "name": "reptrack3",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://nina-nekketsu.github.io/reptrack",
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "prebuild": "node scripts/write-build-info.js",
    "build": "DISABLE_ESLINT_PLUGIN=true NODE_OPTIONS=--no-deprecation react-scripts build",
    "check:prd": "node scripts/check-prd-static-contracts.js && node scripts/qa/release-contracts.js && node scripts/validate-build-metadata.js",
    "qa:release-contracts": "node scripts/qa/release-contracts.js",
    "qa:matrix": "node scripts/qa/release-contracts.js --print-matrix",
    "check:schema": "node scripts/validate-schema.js",
    "lint": "eslint \"src/**/*.{js,jsx}\" --ignore-pattern \"**/*.test.js\" --max-warnings=0",
    "test:prd": "node --test scripts/check-clean.test.js scripts/check-prd-static-contracts.test.js scripts/qa/release-contracts.test.js scripts/validate-build-metadata.test.js scripts/validate-schema.test.js",
    "test": "react-scripts test",
    "qa:done-button-readability": "node scripts/qa-done-button-readability.mjs",
    "qa:mobile-readability": "node scripts/qa-mobile-readability.mjs",
    "qa:mobile-readability:static": "node scripts/qa-mobile-readability-static.mjs",
    "eject": "react-scripts eject",
    "predeploy": "node scripts/check-clean.js && npm run build && node scripts/validate-build-metadata.js --require-origin-main",
    "deploy": "npm run predeploy && gh-pages -d build --no-history"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "gh-pages": "^6.3.0",
    "react-scripts": "^5.0.1"
  }
}
